' ===== RELACIONES DE HERENCIA =====
Persona <|-- Cliente : extends
Persona <|-- Usuario : extends

' ===== RELACIONES DE ASOCIACIÓN =====

' Cliente y sus relaciones
Cliente ||--o{ Carrito : "1" --> "1" : tiene
Cliente ||--o{ Venta : "1" --> "*" : realiza
Cliente ||--o{ MetodoPago : "1" --> "*" : posee

' Carrito y ItemCarrito
Carrito ||--o{ ItemCarrito : "1" --> "*" : contiene

' Producto y sus relaciones
Producto ||--o{ ImgProducto : "1" --> "*" : tiene_imagenes
Producto ||--o{ ItemCarrito : "1" --> "*" : se_añade_a
Producto ||--o{ DetalleVenta : "1" --> "*" : se_vende_en
Producto ||--o{ AjusteStock : "1" --> "*" : tiene_ajustes

' Venta y sus relaciones
Venta ||--o{ DetalleVenta : "1" --> "*" : contiene
Venta ||--|| Factura : "1" --> "1" : genera
Venta ||--|| EnvioSimulado : "1" --> "1" : tiene

' Métodos de pago
MetodoPago ||--o{ DetalleMetodoPago : "1" --> "*" : tiene_detalles

' Estado de envío
EstadoEnvio ||--o{ EnvioSimulado : "1" --> "*" : define_estado

' Usuario y ajustes
Usuario ||--o{ AjusteStock : "1" --> "*" : realiza

' Cupones aplicados a ventas
CuponDescuento ||--o{ Venta : "0" --> "*" : se_aplica_a

' ===== NOTAS EXPLICATIVAS =====
note top of Persona : Clase abstracta base\nque define atributos comunes\npara Cliente y Usuario

note right of Carrito : Gestiona los productos\nseleccionados por el cliente\nantes de la compra

note bottom of Venta : Registra las transacciones\ncompletas con sus detalles\ny métodos de pago

note left of AjusteStock : Registra cambios en el\ninventario con trazabilidad\nde usuario y motivo

note top of LogSistema : Sistema de auditoría\npara seguimiento de\noperaciones importantes

@enduml
